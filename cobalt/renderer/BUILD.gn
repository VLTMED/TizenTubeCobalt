import("//starboard/build/buildflags.gni")
import("//testing/test.gni")

# The font binaries are licensed separately and are never checked into this repo.
declare_args() {
  enable_thmanyah_fonts = false
}

if (enable_thmanyah_fonts) {
  action("generate_thmanyah_font_data") {
    script = "generate_thmanyah_font_header.py"
    _font_root = "//third_party/thmanyah-local-fonts/thmanyah typeface"
    inputs = [
      script,
      "$_font_root/thmanyahsans/otf/thmanyahsans-Light.otf",
      "$_font_root/thmanyahsans/otf/thmanyahsans-Regular.otf",
      "$_font_root/thmanyahsans/otf/thmanyahsans-Medium.otf",
      "$_font_root/thmanyahsans/otf/thmanyahsans-Bold.otf",
      "$_font_root/thmanyahsans/otf/thmanyahsans-Black.otf",
      "$_font_root/thmanyahseriftext/otf/thmanyahseriftext-Light.otf",
      "$_font_root/thmanyahseriftext/otf/thmanyahseriftext-Regular.otf",
      "$_font_root/thmanyahseriftext/otf/thmanyahseriftext-Medium.otf",
      "$_font_root/thmanyahseriftext/otf/thmanyahseriftext-Bold.otf",
      "$_font_root/thmanyahseriftext/otf/thmanyahseriftext-Black.otf",
      "$_font_root/thmanyahserifdisplay/otf/thmanyahserifdisplay-Light.otf",
      "$_font_root/thmanyahserifdisplay/otf/thmanyahserifdisplay-Regular.otf",
      "$_font_root/thmanyahserifdisplay/otf/thmanyahserifdisplay-Medium.otf",
      "$_font_root/thmanyahserifdisplay/otf/thmanyahserifdisplay-Bold.otf",
      "$_font_root/thmanyahserifdisplay/otf/thmanyahserifdisplay-Black.otf",
    ]
    outputs = [ "$target_gen_dir/thmanyah_font_data.h" ]
    args = [
      "--font-root",
      rebase_path(_font_root, root_build_dir),
      "--output",
      rebase_path(outputs[0], root_build_dir),
    ]
  }
}


source_set("renderer") {
  sources = [
    "cobalt_content_renderer_client.cc",
    "cobalt_content_renderer_client.h",
    "cobalt_render_frame_observer.cc",
    "cobalt_render_frame_observer.h",
  ]

  deps = [
    "//base",
    "//cobalt/browser:switches",
    "//cobalt/browser/mojom",
    "//cobalt/media/audio:webaudio",
    "//cobalt/media/service/mojom",
    "//cobalt/shell:cobalt_shell_lib",
    "//components/cdm/renderer",
    "//components/js_injection/renderer:renderer",
    "//components/network_hints/renderer",
    "//components/web_cache/renderer",
    "//content/public/common",
    "//content/public/renderer",
    "//content/test:content_test_mojo_bindings",
    "//media",
    "//media/mojo:buildflags",
    "//starboard:starboard_headers_only",
    "//v8",
  ]

  if (use_starboard_media) {
    deps += [ "//media/mojo/clients" ]

    if (is_ios && is_internal_build) {
      deps += [ "//cobalt/internal/cobalt/components/cdm/renderer/starboard:platform_drm_key_system_info" ]
    }
  }
  if (enable_thmanyah_fonts) {
    deps += [ ":generate_thmanyah_font_data" ]
    include_dirs = [ "$target_gen_dir" ]
    defines = [ "ENABLE_THMANYAH_FONTS" ]
  }
}

test("cobalt_renderer_unittests") {
  testonly = true
  sources = [
    "cobalt_content_renderer_client_unittest.cc",
    "cobalt_render_frame_observer_unittest.cc",
  ]
  deps = [
    ":renderer",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//media",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/blink/renderer/modules/exported:test_support",
    "//v8",
  ]
}
